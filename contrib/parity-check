#!/usr/bin/env bash
# contrib/parity-check — the parity gate for both ported verbs against
# their oracles: `toolsmith check` against contrib/check-contract, and
# `toolsmith new` against contrib/new-tool.sh
# (assets/playbook/parity-gate.md, the recipe this implements section by
# section; docs/binary/port-spec.md §10, the spec for what this must
# cover). Driven by `make parity`.
#
# The two verbs are under different parity contracts, because their output
# has different shapes (port spec §1, §9.2):
#   check  stdout bytes plus exit code, on repos where the oracle's grep
#          is correct.
#   new    the produced directory tree, the happy-path checklist bytes,
#          and exit 0. Its payload is a tree, not stdout, so the gate
#          diffs trees; and its failure-path exit codes are excluded,
#          because the port follows CONTRACT C2.4 where the oracle exits
#          1 for everything (port spec §9.3).
#
# Local only, on purpose (parity-gate §7): the corpus lives on this host,
# never in CI, so this is NOT a dependency of `make check`. `make parity`
# builds the binary first; this script also fails clearly, before running
# anything, if either oracle or the built binary is missing.
#
# Corpus for check: five repos, pinned and extracted with
# `git archive <ref> | tar -x` into this script's own scratch tree, never
# read from a live working tree (two of the five sit on other branches; a
# live worktree would make the recorded baseline unfalsifiable):
#   wip      ~/Code/wip   branch go       5be0507
#   duo      ~/Code/duo   branch go       7763ef1
#   ste9     ~/Code/ste9  branch go-port  2185ca4
#   smoke    tmp/smoke    regenerated by `make smoke`
#   toolsmith  .          working tree (this repo, never extracted)
#
# Corpus for new: instantiated at run time into this script's scratch tree,
# once per implementation per case — there is nothing to pin, since the
# input is the shipped skeleton both implementations already read.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ORACLE="$ROOT/contrib/check-contract"
ORACLE_NEW="$ROOT/contrib/new-tool.sh"
PORT_BIN="$ROOT/bin/toolsmith"

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

pass=0
fail=0
first_failure=""
declare -a failure_blocks=()
LAST_EXIT=0
LAST_FINDING_COUNT=0

record_pass() {
  pass=$((pass + 1))
  echo "  ok  - $1"
}

record_fail() {
  fail=$((fail + 1))
  local msg="$1" detail="${2:-}"
  echo "  FAIL - $msg"
  if [[ -z "$first_failure" ]]; then
    first_failure="$msg"
  fi
  local block="$msg"
  if [[ -n "$detail" ]]; then
    block+=$'\n'"$detail"
  fi
  failure_blocks+=("$block")
}

# run_capturing runs "$@", saving stdout to $1... no: outfile/errfile are
# the first two args, the command is the rest. Sets LAST_EXIT.
run_capturing() {
  local outfile="$1" errfile="$2"
  shift 2
  "$@" >"$outfile" 2>"$errfile"
  LAST_EXIT=$?
}

preflight() {
  if [[ ! -x "$ORACLE_NEW" ]]; then
    echo "parity: new oracle not found or not executable at $ORACLE_NEW" >&2
    exit 1
  fi
  if [[ ! -x "$ORACLE" ]]; then
    echo "parity: oracle not found or not executable at $ORACLE" >&2
    exit 1
  fi
  if [[ ! -x "$PORT_BIN" ]]; then
    echo "parity: toolsmith binary not built (missing $PORT_BIN) — run 'make build'" >&2
    exit 1
  fi
}

# verify_pin resolves ref in repo and fails the whole run (parity-gate §7 —
# never produce an empty pass on a bad precondition) if the repo is
# missing, the ref does not resolve, or the resolved commit does not start
# with the pinned prefix.
verify_pin() {
  local name="$1" repo="$2" ref="$3" want="$4"
  if [[ ! -d "$repo" ]]; then
    echo "parity: corpus repo \"$name\" not found at $repo" >&2
    exit 1
  fi
  local got
  if ! got="$(git -C "$repo" rev-parse "$ref" 2>/dev/null)"; then
    echo "parity: corpus repo \"$name\" ($repo): ref \"$ref\" does not resolve" >&2
    exit 1
  fi
  if [[ "$got" != "$want"* ]]; then
    echo "parity: corpus repo \"$name\" ($repo): ref \"$ref\" resolves to $got, pin expects $want" >&2
    exit 1
  fi
  echo "pin ok: $name @ $ref = $got (matches pin $want)"
}

extract_pin() {
  local repo="$1" ref="$2" dest="$3"
  mkdir -p "$dest"
  git -C "$repo" archive "$ref" | tar -x -C "$dest"
}

# run_parity_case asserts parity-gate §5's three things for one case: byte
# equality of stdout with the exit code appended (one diff covers either
# mismatch), no stderr from the port on a clean run (port spec §9.4's
# multiple-cmd/-entries note is the one named exception), and
# self-determinism across three port runs. Sets LAST_FINDING_COUNT to the
# oracle's finding-line count, for baseline comparison by the caller.
run_parity_case() {
  local label="$1" dir="$2"
  local base="$WORKDIR/out/$label"
  mkdir -p "$base"

  run_capturing "$base/oracle.out" "$base/oracle.err" "$ORACLE" "$dir"
  local oracle_exit=$LAST_EXIT

  run_capturing "$base/port1.out" "$base/port1.err" "$PORT_BIN" check "$dir"
  local port_exit=$LAST_EXIT

  {
    cat "$base/oracle.out"
    echo "exit=$oracle_exit"
  } >"$base/oracle.blob"
  {
    cat "$base/port1.out"
    echo "exit=$port_exit"
  } >"$base/port1.blob"

  if diff -u "$base/oracle.blob" "$base/port1.blob" >"$base/stdout.diff"; then
    record_pass "parity[$label]: stdout+exit byte-identical"
  else
    record_fail "parity[$label]: stdout+exit mismatch" "$(cat "$base/stdout.diff")"
  fi

  if [[ "$port_exit" -eq 0 ]]; then
    if [[ ! -s "$base/port1.err" ]]; then
      record_pass "stderr[$label]: clean run, no stderr"
    elif grep -Eq '^note: multiple cmd/ entries \(.*\); auditing as ".*"$' "$base/port1.err" \
      && [[ "$(wc -l <"$base/port1.err")" -eq 1 ]]; then
      record_pass "stderr[$label]: clean run, only the §9.4 multiple-cmd/-entries note"
    else
      record_fail "stderr[$label]: clean run produced unexpected stderr" "$(cat "$base/port1.err")"
    fi
  fi

  run_capturing "$base/port2.out" "$base/port2.err" "$PORT_BIN" check "$dir"
  local port2_exit=$LAST_EXIT
  run_capturing "$base/port3.out" "$base/port3.err" "$PORT_BIN" check "$dir"
  local port3_exit=$LAST_EXIT
  {
    cat "$base/port2.out"
    echo "exit=$port2_exit"
  } >"$base/port2.blob"
  {
    cat "$base/port3.out"
    echo "exit=$port3_exit"
  } >"$base/port3.blob"

  local det_diff=""
  if ! diff -u "$base/port1.blob" "$base/port2.blob" >"$base/det12.diff"; then
    det_diff="$(cat "$base/det12.diff")"
  elif ! diff -u "$base/port1.blob" "$base/port3.blob" >"$base/det13.diff"; then
    det_diff="$(cat "$base/det13.diff")"
  fi
  if [[ -z "$det_diff" ]]; then
    record_pass "determinism[$label]: three port runs identical"
  else
    record_fail "determinism[$label]: port runs differ" "$det_diff"
  fi

  LAST_FINDING_COUNT="$(grep -c '^C[0-9]' "$base/oracle.out")"
}

# check_baseline compares a case's finding count against the recorded
# baseline in evidence/2026-09-10-conformance.md, distinct from a parity
# mismatch: parity says "the port agrees with the oracle," baseline says
# "the oracle itself still agrees with what we recorded it doing before."
check_baseline() {
  local label="$1" expected="$2"
  if [[ "$LAST_FINDING_COUNT" -eq "$expected" ]]; then
    record_pass "baseline[$label]: $LAST_FINDING_COUNT findings (matches evidence/2026-09-10-conformance.md)"
  else
    record_fail "baseline-drift[$label]: evidence/2026-09-10-conformance.md records $expected, oracle now reports $LAST_FINDING_COUNT"
  fi
}

# --- generated probes (parity-gate §3) --------------------------------
#
# Checked-in fixtures never reach the C6.2-else branch, a 2+-entry cmd/,
# a CRLF workflow file, or a pretty-printed manifest (port spec §10) — the
# five corpus repos are too well-behaved. Everything below is generated
# into $WORKDIR at run time and never committed, so the repo's own hygiene
# hooks never see it (parity-gate §3).

# generate_c62_mislabel_probe: Makefile present, cliff.toml absent — the
# oracle's else branch (contrib/check-contract:86-89) reports the real
# C6.2 condition under the C6.3 label. Port spec §9.6 rules "reproduce
# both," so this is a parity case: oracle and port must match exactly,
# mislabel included.
generate_c62_mislabel_probe() {
  local dir="$1"
  mkdir -p "$dir"
  : >"$dir/Makefile"
}

# generate_c62_hole_probe: cliff.toml present, Makefile absent — the same
# else branch's `has_file cliff.toml` is now true, so find_it is never
# called at all: a silent coverage hole (port spec §9.6, repro B). Also a
# parity case — both implementations must stay silently zero here.
generate_c62_hole_probe() {
  local dir="$1"
  mkdir -p "$dir"
  : >"$dir/cliff.toml"
}

# generate_changelog_tracked_probe: a git working tree with CHANGELOG.md in
# the index. contrib/check-contract:91-96 gates its C6.3 check on
# `git rev-parse --git-dir`, so the branch that *emits* the finding is
# unreachable from the rest of the corpus: the three external repos are
# `git archive` extractions and carry no .git at all, and toolsmith and
# tmp/smoke are inside a working tree whose CHANGELOG.md is generated per
# release, never committed (C6.3 is exactly that rule). Port spec §10's
# "what the fixed corpus does not reach" list does not name this branch —
# that omission is a finding against the spec, not a reason to leave the
# branch untested. `git ls-files` reads the index, so `git add` with no
# commit is enough and the probe needs no committer identity.
generate_changelog_tracked_probe() {
  local dir="$1"
  mkdir -p "$dir"
  printf '# Changelog\n' >"$dir/CHANGELOG.md"
  git -C "$dir" init -q
  git -C "$dir" add CHANGELOG.md
}

# manifest_json_literal prints a compact, contract-conformant manifest
# document: schemaVersion, contract, manifest_digest all present with the
# exact prefixes both the oracle's grep and the port's field checks
# require (port spec §9.1).
manifest_json_literal() {
  printf '{"schemaVersion":1,"contract":"toolsmith/v1","manifest_digest":"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd"}'
}

probe_main_go() {
  cat <<EOF
package main

import (
	"fmt"
	"os"
)

const manifestJSON = \`$(manifest_json_literal)\`

func main() {
	if len(os.Args) >= 3 && os.Args[1] == "manifest" && os.Args[2] == "--json" {
		fmt.Print(manifestJSON)
		return
	}
	os.Exit(1)
}
EOF
}

# generate_multicmd_probe builds an otherwise fully contract-clean repo
# with two cmd/ entries (aaa, bbb) — the shape port spec §9.4 needs: exit 0
# (clean) *and* non-empty stderr (the multiple-cmd/-entries note), in
# tension with the gate's own "no stderr on a clean run" assertion. A
# parity case: oracle and port must agree byte-for-byte, note included.
generate_multicmd_probe() {
  local dir="$1"
  mkdir -p "$dir/cmd/aaa" "$dir/cmd/bbb" "$dir/.github/workflows" "$dir/contrib"

  cat >"$dir/go.mod" <<'EOF'
module parity-probe-multicmd

go 1.23
EOF
  probe_main_go >"$dir/cmd/aaa/main.go"
  probe_main_go >"$dir/cmd/bbb/main.go"

  cat >"$dir/Makefile" <<'EOF'
# probe fixture -- not a real Makefile, only grepped by contrib/check-contract
CGO_ENABLED=0
VERSION := $(shell git describe --tags --match 'v[0-9]*' --always --dirty)

hooks:
	pre-commit install --hook-type pre-commit --hook-type commit-msg
EOF

  cat >"$dir/flake.nix" <<'EOF'
{ CGO_ENABLED = 0; }
EOF

  cat >"$dir/.envrc" <<'EOF'
use flake
EOF

  cat >"$dir/.golangci.yml" <<'EOF'
version: "2"
linters:
  default: none
  enable:
    - forbidigo
linters-settings:
  forbidigo:
    forbid:
      - 'fmt\.Print('
EOF

  cat >"$dir/cliff.toml" <<'EOF'
tag_pattern = "v[0-9]*"
EOF

  local sha="0123456789abcdef0123456789abcdef01234567"
  for wf in ci release; do
    cat >"$dir/.github/workflows/$wf.yml" <<EOF
name: $wf
jobs:
  build:
    steps:
      - run: nix develop --command true
      - uses: actions/checkout@$sha
EOF
  done

  : >"$dir/contrib/check-commit-msg"

  cat >"$dir/.pre-commit-config.yaml" <<'EOF'
repos:
  - hooks:
      - id: commit-msg
EOF

  cat >"$dir/README.md" <<'EOF'
probe fixture
EOF
}

# generate_crlf_probe: a workflow file with CRLF line endings and one
# genuinely SHA-pinned action. Port spec §9.7: the oracle's `read -r` keeps
# the trailing \r, so it reports a correctly pinned action as unpinned.
# Port-only assertion, not parity — routed there up front, not discovered
# as a failure (parity-gate §3's required CRLF probe).
generate_crlf_probe() {
  local dir="$1"
  mkdir -p "$dir/.github/workflows"
  local sha="0123456789abcdef0123456789abcdef01234567"
  printf 'name: ci\r\njobs:\r\n  build:\r\n    steps:\r\n      - run: nix develop --command true\r\n      - uses: actions/checkout@%s\r\n' \
    "$sha" >"$dir/.github/workflows/ci.yml"
}

# generate_prettyjson_probe: a cmd/<tool> whose own `manifest --json` pretty
# -prints. Port spec §9.1: the oracle's grep assumes compact JSON (no space
# after ':'), so it misses fields that are genuinely present. Port-only
# assertion, not parity.
generate_prettyjson_probe() {
  local dir="$1"
  mkdir -p "$dir/cmd/prettytool"
  cat >"$dir/go.mod" <<'EOF'
module parity-probe-prettyjson

go 1.23
EOF
  cat >"$dir/cmd/prettytool/main.go" <<EOF
package main

import (
	"fmt"
	"os"
)

const manifestJSON = \`{
  "schemaVersion": 1,
  "contract": "toolsmith/v1",
  "manifest_digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd"
}\`

func main() {
	if len(os.Args) >= 3 && os.Args[1] == "manifest" && os.Args[2] == "--json" {
		fmt.Print(manifestJSON)
		return
	}
	os.Exit(1)
}
EOF
}

run_crlf_probe() {
  local dir="$1"
  local base="$WORKDIR/out/probe-crlf"
  mkdir -p "$base"
  run_capturing "$base/port.out" "$base/port.err" "$PORT_BIN" check "$dir"
  if grep -q 'action not SHA-pinned' "$base/port.out"; then
    record_fail "port-only[crlf]: port reported a correctly SHA-pinned CRLF action as unpinned (port spec §9.7)" "$(cat "$base/port.out")"
  else
    record_pass "port-only[crlf]: CRLF-terminated, correctly-pinned action recognized as pinned (§9.7 exclusion)"
  fi
  run_capturing "$base/oracle.out" "$base/oracle.err" "$ORACLE" "$dir"
  echo "  info - oracle on the same CRLF probe (expected to diverge per §9.7, not asserted):"
  sed 's/^/         /' "$base/oracle.out"
}

run_prettyjson_probe() {
  local dir="$1"
  local base="$WORKDIR/out/probe-prettyjson"
  mkdir -p "$base"
  run_capturing "$base/port.out" "$base/port.err" "$PORT_BIN" check "$dir"
  if grep -Eq '^C3\.(1|4|6):' "$base/port.out"; then
    record_fail "port-only[prettyjson]: port raised a false C3.1/C3.4/C3.6 finding on a pretty-printed manifest (port spec §9.1)" "$(cat "$base/port.out")"
  else
    record_pass "port-only[prettyjson]: pretty-printed manifest fields parsed correctly (§9.1 exclusion)"
  fi
  run_capturing "$base/oracle.out" "$base/oracle.err" "$ORACLE" "$dir"
  echo "  info - oracle on the same pretty-printed probe (expected to diverge per §9.1, not asserted):"
  sed 's/^/         /' "$base/oracle.out"
}

# --- CLI contract (parity-gate §4) -------------------------------------
run_cli_cases() {
  local base="$WORKDIR/out/cli"
  mkdir -p "$base"

  # non-directory argument
  local notadir="$WORKDIR/not-a-dir.txt"
  : >"$notadir"
  run_capturing "$base/nondir-oracle.out" "$base/nondir-oracle.err" "$ORACLE" "$notadir"
  local o_exit=$LAST_EXIT
  run_capturing "$base/nondir-port.out" "$base/nondir-port.err" "$PORT_BIN" check "$notadir"
  local p_exit=$LAST_EXIT
  if [[ "$o_exit" -eq "$p_exit" ]]; then
    record_pass "cli: non-directory argument, both exit $p_exit (port spec §8.1 — exit code under parity, message text is not)"
  else
    record_fail "cli: non-directory argument — oracle exit $o_exit, port exit $p_exit"
  fi

  # wrong argument count (two positionals)
  run_capturing "$base/argc-oracle.out" "$base/argc-oracle.err" "$ORACLE" a b
  o_exit=$LAST_EXIT
  run_capturing "$base/argc-port.out" "$base/argc-port.err" "$PORT_BIN" check a b
  p_exit=$LAST_EXIT
  if [[ "$o_exit" -eq "$p_exit" ]]; then
    record_pass "cli: wrong argument count (2 positionals), both exit $p_exit"
  else
    record_fail "cli: wrong argument count — oracle exit $o_exit, port exit $p_exit"
  fi

  # zero arguments — port spec §1 judgment call 2: the port defaults path
  # to "." (cwd, here $ROOT — clean, exit 0); the oracle requires exactly
  # one argument and exits 2. A documented divergence, not a parity
  # requirement — this asserts the divergence itself still holds the
  # documented shape, so a silent behavior change would still be caught.
  run_capturing "$base/zero-oracle.out" "$base/zero-oracle.err" "$ORACLE"
  o_exit=$LAST_EXIT
  (cd "$ROOT" && "$PORT_BIN" check >"$base/zero-port.out" 2>"$base/zero-port.err")
  p_exit=$?
  if [[ "$o_exit" -eq 2 && "$p_exit" -eq 0 ]]; then
    record_pass "cli: zero arguments — oracle exit 2, port defaults to '.' and exits 0 (documented divergence, port spec §1 judgment call 2)"
  else
    record_fail "cli: zero arguments — expected oracle=2/port=0 (documented divergence), got oracle=$o_exit/port=$p_exit"
  fi
}

# --- new: tree parity (port spec §9.2) ---------------------------------
#
# `new` has no stdout data contract: its output is a directory tree, and
# the trailing checklist is all stdout carries (port spec §5.2). So the
# parity contract for this verb is the produced tree, the happy-path
# checklist bytes, and exit 0 — assets/playbook/parity-gate.md assumes an
# input-to-stdout tool throughout §1-§6 and never contemplates this shape.
#
# Both implementations run from their own scratch parent with the *same*
# --dir string, because the oracle prints $target_dir back verbatim
# (contrib/new-tool.sh:118, never absolutized). Passing two different
# absolute paths would make the checklist differ for a reason that has
# nothing to do with the port.
#
# What the tree comparison asserts, and what it deliberately does not:
# every relative path, every file's bytes, and the executable bit. Not the
# full permission mode. `cp -R` copies the skeleton's own bits, so the
# oracle's tree carries whatever the developer's umask left on the checked
# -out working copy (664/775 on this host) — a fact about the checkout, not
# about the tool. The port writes from the asset chain, whose embedded link
# reports every file as 0444 and cannot carry the bit at all, so it
# reconstitutes the one bit that matters from the shebang. Comparing full
# modes would assert the umask; comparing the executable bit asserts that
# an instantiated tree's hooks still run.
compare_trees() { # compare_trees <label> <oracle-dir> <port-dir>
  local label="$1" odir="$2" pdir="$3"
  local base="$WORKDIR/out/new-$label"
  mkdir -p "$base"

  (cd "$odir" && find . -path ./.git -prune -o \( -type f -o -type l \) -print | sort) >"$base/oracle.paths"
  (cd "$pdir" && find . -path ./.git -prune -o \( -type f -o -type l \) -print | sort) >"$base/port.paths"
  if diff -u "$base/oracle.paths" "$base/port.paths" >"$base/paths.diff"; then
    record_pass "new[$label]: identical file set ($(wc -l <"$base/oracle.paths") files)"
  else
    record_fail "new[$label]: file sets differ" "$(cat "$base/paths.diff")"
  fi

  if diff -r --exclude=.git "$odir" "$pdir" >"$base/content.diff" 2>&1; then
    record_pass "new[$label]: every file byte-identical"
  else
    record_fail "new[$label]: file contents differ" "$(cat "$base/content.diff")"
  fi

  (cd "$odir" && find . -path ./.git -prune -o -type f -perm -u+x -print | sort) >"$base/oracle.x"
  (cd "$pdir" && find . -path ./.git -prune -o -type f -perm -u+x -print | sort) >"$base/port.x"
  if diff -u "$base/oracle.x" "$base/port.x" >"$base/x.diff"; then
    record_pass "new[$label]: identical executable bits ($(wc -l <"$base/oracle.x") executable)"
  else
    record_fail "new[$label]: executable bits differ" "$(cat "$base/x.diff")"
  fi
}


# compare_git asserts what the tree comparison deliberately skips. Two
# independent `git init` runs never produce identical object stores — the
# reflog and config carry timestamps and paths — so .git is excluded from
# the file comparison above, and what is compared instead is what the
# oracle's three git calls are actually for: the branch name, the commit
# message, and the tree the commit points at. A tree hash is content-derived,
# so equal hashes mean both implementations committed exactly the same tree.
compare_git() { # compare_git <label> <oracle-dir> <port-dir>
  local label="$1" odir="$2" pdir="$3"
  local field ogot pgot ok=1
  for field in "rev-parse --abbrev-ref HEAD" "log -1 --format=%s" "rev-parse HEAD^{tree}"; do
    # shellcheck disable=SC2086
    # $field is a deliberately word-split git argument list.
    ogot="$(git -C "$odir" $field 2>&1)"
    # shellcheck disable=SC2086
    pgot="$(git -C "$pdir" $field 2>&1)"
    if [[ "$ogot" != "$pgot" ]]; then
      record_fail "new[$label]: git $field differs" "oracle: $ogot
port:   $pgot"
      ok=0
    fi
  done
  if [[ "$ok" -eq 1 ]]; then
    record_pass "new[$label]: same branch, commit message, and committed tree hash"
  fi
}
# run_new_case instantiates <name> with both implementations and asserts
# parity-gate §5's three things in this verb's shape: tree plus checklist
# bytes plus exit code, no stderr from the port on a clean run, and
# self-determinism across three port runs.
run_new_case() { # run_new_case <label> <name> [extra args...]
  local label="$1" name="$2"
  shift 2
  local base="$WORKDIR/out/new-$label"
  mkdir -p "$base/oracle" "$base/port"

  (cd "$base/oracle" && "$ORACLE_NEW" "$name" --dir "$name" "$@") \
    >"$base/oracle.out" 2>"$base/oracle.err"
  local oracle_exit=$?
  (cd "$base/port" && "$PORT_BIN" new "$name" --dir "$name" "$@") \
    >"$base/port.out" 2>"$base/port.err"
  local port_exit=$?

  echo "exit=$oracle_exit" >>"$base/oracle.out"
  echo "exit=$port_exit" >>"$base/port.out"

  if diff -u "$base/oracle.out" "$base/port.out" >"$base/stdout.diff"; then
    record_pass "new[$label]: checklist bytes + exit identical"
  else
    record_fail "new[$label]: checklist/exit mismatch" "$(cat "$base/stdout.diff")"
  fi

  if [[ "$port_exit" -eq 0 && -s "$base/port.err" ]]; then
    record_fail "new[$label]: clean run produced stderr" "$(cat "$base/port.err")"
  elif [[ "$port_exit" -eq 0 ]]; then
    record_pass "new[$label]: clean run, no stderr"
  fi

  compare_trees "$label" "$base/oracle/$name" "$base/port/$name"

  if [[ -d "$base/port/$name/.git" || -d "$base/oracle/$name/.git" ]]; then
    compare_git "$label" "$base/oracle/$name" "$base/port/$name"
  fi

  # Self-determinism: two more port runs into fresh parents, compared as
  # trees and as checklist bytes. .git is excluded for the same reason
  # compare_trees excludes it — two independent `git init` runs differ in
  # their object stores by construction, so including it would report the
  # port as nondeterministic on every git-path case.
  local det_fail=""
  local i
  for i in 2 3; do
    mkdir -p "$base/port$i"
    (cd "$base/port$i" && "$PORT_BIN" new "$name" --dir "$name" "$@") \
      >"$base/port$i.out" 2>/dev/null
    echo "exit=$?" >>"$base/port$i.out"
    if ! diff -q "$base/port.out" "$base/port$i.out" >/dev/null 2>&1 ||
      ! diff -r --exclude=.git "$base/port/$name" "$base/port$i/$name" >/dev/null 2>&1; then
      det_fail="run $i differs from run 1"
    fi
  done
  if [[ -z "$det_fail" ]]; then
    record_pass "new[$label]: three port runs identical"
  else
    record_fail "new[$label]: port runs differ" "$det_fail"
  fi
}

# run_new_cli_cases covers the failure shapes the tree matrix cannot reach
# (parity-gate §4). Port spec §9.3 draws the boundary these assert against:
# for `new`, stdout and the fact of failure are under parity, the exit code
# is not — the oracle exits 1 for every shape through one die() helper,
# while the port follows C2.4 (2 for Cobra's argument-parsing path, 3 for
# the existing-target refusal, 1 for the rest). Asserting the port's own
# table here is what keeps that divergence from drifting silently.
run_new_cli_cases() {
  local base="$WORKDIR/out/new-cli"
  mkdir -p "$base"
  mkdir -p "$base/taken"

  local label oexit pexit want
  # label|expected port exit|args
  local cases=(
    "unknown flag|2|--bogus acme"
    "bad name shape|1|Acme"
    "the placeholder name|1|toolname"
    "no name|2|"
  )
  local spec args
  for spec in "${cases[@]}"; do
    IFS='|' read -r label want args <<<"$spec"
    # shellcheck disable=SC2086
    # $args is a deliberately word-split argument list, not one argument.
    (cd "$base" && "$ORACLE_NEW" $args) >"$base/o.out" 2>"$base/o.err"
    oexit=$?
    # shellcheck disable=SC2086
    (cd "$base" && "$PORT_BIN" new $args) >"$base/p.out" 2>"$base/p.err"
    pexit=$?

    if [[ -s "$base/o.out" || -s "$base/p.out" ]]; then
      record_fail "new-cli[$label]: a failure path wrote to stdout" \
        "oracle: $(cat "$base/o.out")
port:   $(cat "$base/p.out")"
    elif [[ "$oexit" -eq 1 && "$pexit" -eq "$want" ]]; then
      record_pass "new-cli[$label]: oracle exits 1, port exits $want (port spec §9.3, exit codes excluded from parity)"
    else
      record_fail "new-cli[$label]: expected oracle=1/port=$want, got oracle=$oexit/port=$pexit"
    fi
  done

  # The existing-target refusal, the one shape with its own C2.4 code.
  (cd "$base" && "$ORACLE_NEW" acme --dir taken) >"$base/o.out" 2>"$base/o.err"
  oexit=$?
  (cd "$base" && "$PORT_BIN" new acme --dir taken) >"$base/p.out" 2>"$base/p.err"
  pexit=$?
  if [[ ! -s "$base/o.out" && ! -s "$base/p.out" && "$oexit" -eq 1 && "$pexit" -eq 3 ]]; then
    record_pass "new-cli[existing target]: oracle exits 1, port exits 3 as a refusal (port spec §9.3)"
  else
    record_fail "new-cli[existing target]: expected oracle=1/port=3 with empty stdout, got oracle=$oexit/port=$pexit"
  fi
}

main() {
  preflight

  echo "== resolving corpus pins =="
  verify_pin wip "$HOME/Code/wip" go 5be0507
  verify_pin duo "$HOME/Code/duo" go 7763ef1
  verify_pin ste9 "$HOME/Code/ste9" go-port 2185ca4
  echo "toolsmith: working tree, $ROOT (never extracted, per the corpus table)"

  echo
  echo "== extracting pinned corpus =="
  extract_pin "$HOME/Code/wip" go "$WORKDIR/corpus/wip"
  extract_pin "$HOME/Code/duo" go "$WORKDIR/corpus/duo"
  extract_pin "$HOME/Code/ste9" go-port "$WORKDIR/corpus/ste9"

  echo
  echo "== regenerating smoke corpus (make smoke) =="
  if ! (cd "$ROOT" && make smoke) >"$WORKDIR/smoke.log" 2>&1; then
    echo "parity: 'make smoke' failed — see below" >&2
    cat "$WORKDIR/smoke.log" >&2
    exit 1
  fi
  if [[ ! -d "$ROOT/tmp/smoke" ]]; then
    echo "parity: tmp/smoke missing after 'make smoke'" >&2
    exit 1
  fi

  echo
  echo "== corpus parity =="
  run_parity_case wip "$WORKDIR/corpus/wip"
  check_baseline wip 14
  run_parity_case duo "$WORKDIR/corpus/duo"
  check_baseline duo 11
  run_parity_case ste9 "$WORKDIR/corpus/ste9"
  run_parity_case smoke "$ROOT/tmp/smoke"
  run_parity_case toolsmith "$ROOT"

  echo
  echo "== generated probes: parity (port spec §10) =="
  generate_c62_mislabel_probe "$WORKDIR/probes/c62-mislabel"
  run_parity_case probe-c62-mislabel "$WORKDIR/probes/c62-mislabel"
  generate_c62_hole_probe "$WORKDIR/probes/c62-hole"
  run_parity_case probe-c62-hole "$WORKDIR/probes/c62-hole"
  generate_changelog_tracked_probe "$WORKDIR/probes/changelog-tracked"
  run_parity_case probe-changelog-tracked "$WORKDIR/probes/changelog-tracked"
  generate_multicmd_probe "$WORKDIR/probes/multicmd"
  run_parity_case probe-multicmd "$WORKDIR/probes/multicmd"

  echo
  echo "== generated probes: port-only (port spec §9.1, §9.7) =="
  generate_crlf_probe "$WORKDIR/probes/crlf"
  run_crlf_probe "$WORKDIR/probes/crlf"
  generate_prettyjson_probe "$WORKDIR/probes/prettyjson"
  run_prettyjson_probe "$WORKDIR/probes/prettyjson"

  echo
  echo "== CLI contract (parity-gate §4) =="
  run_cli_cases

  echo
  echo "== new: tree parity (port spec §9.2) =="
  run_new_case default demo --no-git
  # A custom --module is the case the oracle's own comment calls
  # load-bearing: it is the only one where getting the substitution order
  # wrong produces a different tree (port spec §4.2 step 6).
  run_new_case custom-module acme --module example.com/x/acme --no-git
  # The git path: the default, and the one the oracle's two real callers
  # do not use (README.md:64 and Makefile:33 both pass --no-git or take
  # the default happy path). .git itself is excluded from the tree
  # comparison — two independent `git init` runs never produce identical
  # object stores, and the commit is not what this verb is being audited
  # for.
  run_new_case with-git gitdemo

  echo
  echo "== new: CLI contract (port spec §9.3) =="
  run_new_cli_cases

  echo
  echo "== parity gate summary =="
  echo "passed: $pass"
  echo "failed: $fail"
  if [[ "$fail" -gt 0 ]]; then
    echo
    echo "--- mismatches ---"
    local i=1
    for block in "${failure_blocks[@]}"; do
      echo "[$i] $block"
      i=$((i + 1))
    done
    echo
    echo "parity: FAILED — first mismatch: $first_failure"
    exit 1
  fi
  echo "parity: all cases passed"
}

main "$@"
