#!/usr/bin/env bash
# contrib/check-contract — audit a tool repo against the mechanical
# ([check]-marked) clauses of CONTRACT.md. Findings are flat
# "<clause>: <message>" lines, reported exhaustively (T21) — every failing
# clause, never just the first. Exit 0 clean, 1 with findings, 2 usage.
#
# This is the judgment-free floor: a clean run does not mean full
# conformance (most clauses are audited by reading), and a finding is a
# fact about the repo, not always a defect — a pre-v1 tool fails C3.6 by
# construction until it adopts the contract field.
set -euo pipefail

if [[ $# -ne 1 || ! -d "$1" ]]; then
  echo "usage: contrib/check-contract <tool-repo-dir>" >&2
  exit 2
fi
repo="$(cd "$1" && pwd)"

findings=0
find_it() {
  echo "$1: $2"
  findings=$((findings + 1))
}

has_file() { [[ -f "$repo/$1" ]]; }

# --- tool name, from cmd/<name> ------------------------------------------
tool=""
if [[ -d "$repo/cmd" ]]; then
  mapfile -t cmds < <(find "$repo/cmd" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
  if [[ ${#cmds[@]} -eq 1 ]]; then
    tool="${cmds[0]}"
  elif [[ ${#cmds[@]} -gt 1 ]]; then
    tool="${cmds[0]}"
    echo "note: multiple cmd/ entries (${cmds[*]}); auditing as \"$tool\"" >&2
  fi
fi
[[ -n "$tool" ]] || find_it "C1.2" "no cmd/<tool> main package found"

# --- C1.1: CGO_ENABLED=0 in Makefile, CI, and the Nix package ------------
if has_file Makefile; then
  grep -q 'CGO_ENABLED=0' "$repo/Makefile" || find_it "C1.1" "Makefile does not set CGO_ENABLED=0"
else
  find_it "C1.1" "no Makefile"
fi
if has_file flake.nix; then
  grep -Eq 'CGO_ENABLED *= *0|env\.CGO_ENABLED *= *0' "$repo/flake.nix" || find_it "C1.1" "flake.nix does not set CGO_ENABLED = 0"
fi

# --- C1.6: flake.nix + .envrc, share-tree postInstall --------------------
has_file flake.nix || find_it "C1.6" "no flake.nix"
if has_file .envrc; then
  grep -q 'use flake' "$repo/.envrc" || find_it "C1.6" ".envrc does not 'use flake'"
else
  find_it "C1.6" "no .envrc"
fi
if has_file flake.nix && [[ -d "$repo/assets" ]]; then
  grep -q 'share/' "$repo/flake.nix" || find_it "C1.6" "flake.nix postInstall does not install assets into \$out/share"
fi

# --- C2.1: forbidigo enforces the iostreams discipline -------------------
if has_file .golangci.yml; then
  grep -q 'forbidigo' "$repo/.golangci.yml" || find_it "C2.1" ".golangci.yml does not enable forbidigo"
  grep -qF 'fmt\.Print' "$repo/.golangci.yml" || find_it "C2.1" ".golangci.yml forbidigo does not ban fmt.Print*"
else
  find_it "C2.1" "no .golangci.yml"
fi

# --- C3.1/C3.4/C3.6: the manifest verb, its digest and contract field ----
if [[ -n "$tool" ]] && command -v go >/dev/null && has_file go.mod; then
  manifest_json=""
  if manifest_json="$(cd "$repo" && CGO_ENABLED=0 go run "./cmd/$tool" manifest --json 2>/dev/null)"; then
    echo "$manifest_json" | grep -q '"schemaVersion"' || find_it "C3.1" "manifest --json carries no schemaVersion"
    echo "$manifest_json" | grep -q '"manifest_digest":"sha256:' || find_it "C3.4" "manifest --json carries no manifest_digest"
    echo "$manifest_json" | grep -q '"contract":"toolsmith/' || find_it "C3.6" "manifest --json declares no toolsmith contract version"
  else
    find_it "C3.1" "\`$tool manifest --json\` failed or is not implemented"
  fi
else
  find_it "C3.1" "cannot run the manifest verb (need go, go.mod, and cmd/<tool>)"
fi

# --- C6.2: tag namespace agreement (Makefile <-> cliff.toml) -------------
if has_file Makefile && has_file cliff.toml; then
  grep -q -- "--match 'v\[0-9\]\*'" "$repo/Makefile" || find_it "C6.2" "Makefile git describe lacks --match 'v[0-9]*'"
  grep -q 'tag_pattern *= *"v\[0-9\]\*"' "$repo/cliff.toml" || find_it "C6.2" "cliff.toml tag_pattern is not \"v[0-9]*\""
else
  has_file cliff.toml || find_it "C6.3" "no cliff.toml (changelog is not derivable from tags)"
fi

# --- C6.3: CHANGELOG.md is never committed -------------------------------
if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
  if [[ -n "$(git -C "$repo" ls-files CHANGELOG.md)" ]]; then
    find_it "C6.3" "CHANGELOG.md is tracked; the contract generates it per release instead"
  fi
fi

# --- C6.5: workflows exist, run through nix, actions SHA-pinned ----------
for wf in ci.yml release.yml; do
  if has_file ".github/workflows/$wf"; then
    grep -q 'nix develop --command' "$repo/.github/workflows/$wf" || find_it "C6.5" "$wf does not run through 'nix develop --command'"
    while IFS= read -r line; do
      ref="${line##*@}"
      ref="${ref%% *}"
      trimmed="${line#"${line%%[![:space:]]*}"}"
      [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || find_it "C6.5" "$wf: action not SHA-pinned: $trimmed"
    done < <(grep -E '^\s*-? *uses:' "$repo/.github/workflows/$wf")
  else
    find_it "C6.5" "no .github/workflows/$wf"
  fi
done

# --- C6.6: conventional commits enforced, both hook stages installed -----
has_file contrib/check-commit-msg || find_it "C6.6" "no contrib/check-commit-msg hook"
if has_file .pre-commit-config.yaml; then
  grep -q 'commit-msg' "$repo/.pre-commit-config.yaml" || find_it "C6.6" ".pre-commit-config.yaml has no commit-msg stage hook"
else
  find_it "C6.6" "no .pre-commit-config.yaml"
fi
if has_file Makefile && grep -qE '^hooks:' "$repo/Makefile"; then
  grep -q -- '--hook-type commit-msg' "$repo/Makefile" || find_it "C6.6" "make hooks does not install the commit-msg stage"
fi

# --- C6.7: golangci schema v2, default none ------------------------------
if has_file .golangci.yml; then
  grep -q 'version: "2"' "$repo/.golangci.yml" || find_it "C6.7" ".golangci.yml is not schema version 2"
  grep -q 'default: none' "$repo/.golangci.yml" || find_it "C6.7" ".golangci.yml does not use 'default: none'"
fi

# --- C7.5: README exists -------------------------------------------------
has_file README.md || find_it "C7.5" "no README.md"

if [[ $findings -eq 0 ]]; then
  echo "no findings — mechanical clauses hold for $repo"
  exit 0
fi
echo "$findings finding(s) for $repo" >&2
exit 1
