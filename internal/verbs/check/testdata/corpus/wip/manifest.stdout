{"tool":{"name":"wip","version":"dev","commit":"unknown","date":"unknown"},"schemaVersion":1,"verbs":[{"name":"backlog add","kind":"plumbing","args":[{"name":"detail","type":"string","required":false},{"name":"origin","type":"string","required":false},{"name":"provenance","type":"string","required":true},{"name":"title","type":"string","required":true}],"description":"enter a new backlog entry"},{"name":"backlog decline","kind":"plumbing","args":[{"name":"reason","type":"string","required":true}],"description":"decline a backlog entry — the P1 decline exit"},{"name":"backlog delegate","kind":"plumbing","args":null,"description":"delegate a backlog entry through the tracker outbox"},{"name":"backlog list","kind":"plumbing","args":null,"description":"list this repo's backlog — read-only, emits no event"},{"name":"backlog plan","kind":"plumbing","args":null,"description":"promote a backlog entry into a matter"},{"name":"batch create","kind":"plumbing","args":null,"description":"create a named Batch"},{"name":"batch dismiss","kind":"plumbing","args":null,"description":"dismiss a named Batch"},{"name":"batch join","kind":"plumbing","args":null,"description":"join a Matter to a named Batch"},{"name":"batch leave","kind":"plumbing","args":null,"description":"remove a Matter from a named Batch"},{"name":"bind","kind":"plumbing","args":null,"description":"add a tracker reference to a Matter"},{"name":"body","kind":"plumbing","args":[{"name":"file","type":"string","required":false}],"description":"write a node's own prose body (create-once)"},{"name":"brief","kind":"plumbing","args":[{"name":"file","type":"string","required":false}],"description":"write a node's Brief (create-once)"},{"name":"cancel","kind":"plumbing","args":[{"name":"reason","type":"string","required":false}],"description":"move a matter, stage or step from In Progress to Canceled"},{"name":"clean","kind":"plumbing","args":null,"description":"reap crash-orphaned dispatch scratch directories and orphaned blobs"},{"name":"clone list","kind":"plumbing","args":[{"name":"repo","type":"string","required":false}],"description":"list a repo's known clones"},{"name":"clone relink","kind":"plumbing","args":null,"description":"point a known clone's row at this directory (the clone moved)"},{"name":"depend add","kind":"plumbing","args":[{"name":"blocked-by","type":"string","required":true}],"description":"add a blocked-by edge: \u003cnode\u003e waits for --blocked-by"},{"name":"depend remove","kind":"plumbing","args":[{"name":"blocked-by","type":"string","required":true}],"description":"remove a blocked-by edge — tombstoned, not deleted (D44)"},{"name":"dispatch close","kind":"plumbing","args":null,"description":"close this worktree's open dispatch with reason completed, and sweep its scratch dir"},{"name":"doctor","kind":"plumbing","args":null,"description":"diagnose this location against what wip knows"},{"name":"finding add","kind":"plumbing","args":[{"name":"file","type":"string","required":false}],"description":"append one finding — a positional argument, or stdin/--file for a longer one"},{"name":"finish","kind":"plumbing","args":null,"description":"move a matter, stage or step from In Progress to Done"},{"name":"gate close","kind":"plumbing","args":null,"description":"close a declared gate against a node"},{"name":"gate declare","kind":"plumbing","args":[{"name":"scale","type":"string","required":true}],"description":"declare a gate at a scale — project config, not a domain event"},{"name":"gate repair","kind":"plumbing","args":null,"description":"repair a missed prospective exemption without closing the gate"},{"name":"init","kind":"plumbing","args":[{"name":"identity-remote","type":"string","required":false}],"description":"attach the current git clone (and its worktree) to wip"},{"name":"install","kind":"plumbing","args":[{"name":"force","type":"bool","required":false}],"description":"render and install wip's self-projection into an agent harness"},{"name":"label","kind":"plumbing","args":null,"description":"set or rename the current clone's label"},{"name":"manifest","kind":"plumbing","args":null,"description":"print wip's machine-readable self-description: verbs, kinds, tracker backends, and shipped assets"},{"name":"matter create","kind":"plumbing","args":[{"name":"locator","type":"string","required":false},{"name":"title","type":"string","required":true}],"description":"birth a matter, entering Planned"},{"name":"next","kind":"plumbing","args":[{"name":"clear","type":"bool","required":false},{"name":"set","type":"string","required":false}],"description":"the cursor fused with the unblocked frontier — what to work on next"},{"name":"outbox approve","kind":"plumbing","args":null,"description":"approve one queued entry for delivery"},{"name":"outbox backend","kind":"plumbing","args":null,"description":"read or set this repo's tracker backend"},{"name":"outbox backlog-push","kind":"plumbing","args":null,"description":"read or set this repo's automatic backlog delegation"},{"name":"outbox canceled-label","kind":"plumbing","args":null,"description":"read or set this repo's tracker canceled label"},{"name":"outbox decline","kind":"plumbing","args":[{"name":"reason","type":"string","required":true}],"description":"decline one entry terminally"},{"name":"outbox flush","kind":"plumbing","args":null,"description":"flush approved work through the configured provider seam"},{"name":"outbox level","kind":"plumbing","args":null,"description":"read or set this repo's tracker push level"},{"name":"outbox list","kind":"plumbing","args":null,"description":"list this repo's outbox — read-only, emits no event"},{"name":"outbox retry","kind":"plumbing","args":null,"description":"explicitly retry one failed or withheld entry"},{"name":"outbox target","kind":"plumbing","args":null,"description":"read or set this repo's tracker target"},{"name":"pause","kind":"plumbing","args":null,"description":"move a matter, stage or step from In Progress to Paused"},{"name":"rebind","kind":"plumbing","args":null,"description":"replace a Matter tracker reference atomically"},{"name":"refresh","kind":"plumbing","args":null,"description":"open or continue this worktree's dispatch, and (re-)render .wip/generated/"},{"name":"resume","kind":"plumbing","args":null,"description":"move a matter, stage or step from Paused to In Progress"},{"name":"role active","kind":"plumbing","args":null,"description":"show which outer-loop roles this repo's gate config activates (D14) — read-only, emits no event"},{"name":"role close","kind":"plumbing","args":null,"description":"close this dispatch's open instance of a role, with reason completed"},{"name":"role list","kind":"plumbing","args":null,"description":"list this worktree's dispatch roles, open and closed — read-only, emits no event"},{"name":"role spawn","kind":"plumbing","args":null,"description":"spawn a role instance into this worktree's open dispatch"},{"name":"run list","kind":"plumbing","args":null,"description":"list Runs on this host"},{"name":"run show","kind":"plumbing","args":null,"description":"show one Run"},{"name":"run stand-down","kind":"plumbing","args":null,"description":"stand down an interrupted Run"},{"name":"session","kind":"plumbing","args":[{"name":"idle-gap","type":"string","required":false}],"description":"working periods derived from the event log — what was done recently"},{"name":"stage create","kind":"plumbing","args":[{"name":"title","type":"string","required":true}],"description":"birth a stage under a matter, entering Planned"},{"name":"start","kind":"plumbing","args":null,"description":"move a matter, stage or step from Planned to In Progress"},{"name":"status","kind":"plumbing","args":[{"name":"all","type":"bool","required":false}],"description":"show what's in progress, finished, and next to start"},{"name":"step create","kind":"plumbing","args":[{"name":"title","type":"string","required":true}],"description":"birth a step under a matter or a stage, entering Planned"},{"name":"step insert","kind":"plumbing","args":[{"name":"after","type":"string","required":false},{"name":"before","type":"string","required":false},{"name":"title","type":"string","required":true}],"description":"birth a step between siblings"},{"name":"step remove","kind":"plumbing","args":[{"name":"reason","type":"string","required":false}],"description":"tombstone a step"},{"name":"step reorder","kind":"plumbing","args":null,"description":"rewrite the sibling order of a parent's live steps"},{"name":"step replace","kind":"plumbing","args":[{"name":"title","type":"string","required":true}],"description":"tombstone a step and birth its replacement in the same position"},{"name":"unbind","kind":"plumbing","args":null,"description":"remove a tracker reference from a Matter"},{"name":"uninstall","kind":"plumbing","args":null,"description":"remove a previously installed harness self-projection"},{"name":"version","kind":"plumbing","args":null,"description":"print wip's version, commit, and build date"},{"name":"workplan","kind":"plumbing","args":[{"name":"file","type":"string","required":false}],"description":"write a node's Workplan (create-once)"}],"assets":[{"path":"agent-write-guidance.md","sha256":"51ea76e62f939c5aad0244148a857165a9aa24f94eb36a23c4f2e67adff6b959"},{"path":"chassis-selftest.txt","sha256":"a68c597d039130dc2f4976d3cd9a76b418c6a05c6a71e0b3d8a38629750f96ac"},{"path":"config.default.yaml","sha256":"113581c90dd3ce2a26bf1c435b5ed24732d5e22cf340c3d27ec4a0c982a5b38b"},{"path":"templates/skills/amp/judgment.md","sha256":"1dfddeed0092aef58dbdb4c13399d782106cbab7b3f94a7afe7e2ee976c07699"},{"path":"templates/skills/claude-code/judgment.md","sha256":"1dfddeed0092aef58dbdb4c13399d782106cbab7b3f94a7afe7e2ee976c07699"},{"path":"templates/skills/codex/judgment.md","sha256":"1dfddeed0092aef58dbdb4c13399d782106cbab7b3f94a7afe7e2ee976c07699"},{"path":"templates/skills/devin/judgment.md","sha256":"aba2a15caac61a6afa06507605074a7595ef6f182700aa0a60e766e83