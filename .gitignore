# Private, uncommitted project instructions
/CLAUDE.local.md

# wip's per-clone render tree. Ignored by decision, not by
# .git/info/exclude (C6.8): wip's doctor refuses to render into a
# tracked .wip/, and the Matters themselves live in wip, not here.
/.wip/

# Instantiation smoke-test output
/tmp/

# Build artifacts
/bin/
/dist/

# Nix
/result
/result-*
.direnv/

.DS_Store

# vendor/ is committed whole (flake vendorHash = null). The re-include
# shields it from user-global ignore patterns — a global `*.com` rule
# (Windows executables) would otherwise silently drop vendor/github.com
# from commits.
!vendor/**
